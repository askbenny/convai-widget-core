{
  "name": "@askbenny/convai-widget-core",
  "version": "1.4.5",
  "description": "The common library for the Conversational AI Widget Wrapper for elevenlabs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "type": "module",
  "scripts": {
    "generate-version": "printf \"// This file is auto-generated during build\\nexport const PACKAGE_VERSION = \\\"%s\\\";\\n\" \"$npm_package_version\" > src/version.ts",
    "postinstall": "npm run generate-version",
    "prebuild": "npm run generate-version",
    "build": "vite build && tsc --declaration --emitDeclarationOnly",
    "build:analyze": "ANALYZE=true vite build",
    "dev": "npm run generate-version && vite",
    "lint": "npm run lint:ts && npm run lint:es && npm run lint:prettier",
    "lint:ts": "tsc --noEmit --skipLibCheck",
    "lint:es": "npx eslint .",
    "lint:prettier": "prettier 'src/**/*.ts' --check",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "lint:fix": "npm run lint:ts && npx eslint . --fix && prettier 'src/**/*.ts' --write",
    "test": "vitest",
    "npm:view": "npm view @askbenny/convai-widget-embed",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "version:prerelease": "npm version prerelease --preid=beta"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "ElevenLabs",
  "license": "MIT",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "^3.0.4",
    "@types/preact-custom-element": "^4.0.4",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/browser": "^3.1.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "msw": "^2.7.5",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.5.4",
    "unified": "^11.0.5",
    "vite": "^7.3.1",
    "vite-bundle-analyzer": "^1.3.2",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@elevenlabs/client": "^1.1.1",
    "@lezer/common": "^1.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/html": "^1.3.12",
    "@lezer/javascript": "^1.5.4",
    "@lezer/json": "^1.0.3",
    "@lezer/lr": "^1.4.3",
    "@lezer/markdown": "^1.6.0",
    "@lezer/python": "^1.1.18",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.3",
    "@preact/signals": "^2.0.4",
    "clsx": "^2.1.1",
    "hast-util-from-lezer": "^0.5.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "marked": "^17.0.0",
    "preact": "^10.26.5",
    "preact-custom-element": "^4.3.0",
    "rehype-harden": "^1.1.7",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^1.2.3",
    "remark-cjk-friendly-gfm-strikethrough": "^1.2.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askbenny/convai-widget-core.git",
    "directory": "packages/convai-widget-core"
  }
}
